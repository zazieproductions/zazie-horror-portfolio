# Cloudflare Pages response headers
# -----------------------------------------------------------------------------
# HOW RULES COMBINE (read before editing)
#
#   Every rule whose pattern matches a request contributes its headers, and a
#   header set by more than one matching rule is JOINED WITH A COMMA -- the more
#   specific rule does not win. That made the previous cache policy a no-op:
#
#     /*
#       Cache-Control: public, max-age=0, must-revalidate
#     /fonts/*
#       Cache-Control: public, max-age=31536000, immutable
#
#   served `public, max-age=0, must-revalidate, public, max-age=31536000,
#   immutable`, and RFC 9111 reads the first max-age -- so fonts, images and
#   content-hashed CSS/JS were revalidated on every request.
#
#   So: `/*` is the only rule allowed to set Cache-Control as a default, and
#   every rule that needs a different lifetime first DETACHES it with
#   `! Cache-Control` and then sets its own. Detach is order-sensitive: the
#   broad rule must already have applied, which is why `/*` is first in the file
#   and every detach sits below it.
#
#   tools/check-headers.mjs simulates these joins and fails the build if any
#   path would come out with two Cache-Control lifetimes again.
#
# The security policy lives in tools/headers.mjs; that module and this block are
# checked against each other on every build.
#
# Cloudflare injects its Web Analytics beacon (static.cloudflareinsights.com/
# beacon.min.js) into HTML at the edge; nothing in this repository asks for the
# tag. Since 26 October 2026 the beacon is deliberately allowed: script-src
# names its host exactly (the injected URL carries a version path, so a
# path-scoped source would not match) and connect-src names
# cloudflareinsights.com for its /cdn-cgi/rum reporting endpoint (the
# same-origin form is already covered by 'self'). It is the only remote script
# and the only remote connection allowed, it is cookieless, and /privacy
# sections 1, 3, 4, 6, 8, 9 and 13 disclose it. tools/check-headers.mjs fails
# the build if either host is dropped below or any other remote script/connect
# origin is added. To stop collecting, disable Web Analytics in the Cloudflare
# dashboard and remove both hosts here in the same change.
#
# Cloudflare Pages limit: 100 header rules, 2,000 characters per line.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://drive.google.com https://docs.google.com https://bandcamp.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; upgrade-insecure-requests
  X-DNS-Prefetch-Control: on
  Cache-Control: public, max-age=0, must-revalidate

# The error page is never worth keeping, and a cached 404 poisons the route.
/404.html
  X-Robots-Tag: noindex, follow
  ! Cache-Control
  Cache-Control: no-store

# The service worker must be re-fetched every time, or a stale worker pins the
# previous asset graph in front of the new one for up to 24 hours.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex, follow
  ! Cache-Control
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: index, follow
  ! Cache-Control
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: index, follow
  ! Cache-Control
  Cache-Control: public, max-age=3600

# -----------------------------------------------------------------------------
# Static assets
#
# Every URL below is either fingerprinted by the build (name-<hash8>.css/js) or
# a font/image/audio path whose contents are replaced only together with a
# rebuild that also rewrites every reference, so a year is safe. HTML is the
# only thing that must revalidate.

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/audio/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/index-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/store-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/legal-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/inquiry-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/item-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/reel-download-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Explicit X-Robots-Tag headers on all indexable routes.
#
# THERE IS DELIBERATELY NO `Link: <…>; rel="canonical"` RULE HERE.
#
# Until 2026-10-30 every indexable route carried one, and the edge mangled all
# of them: Cloudflare Pages drops an angle-bracketed segment from a `_headers`
# value, so the live response for `/`, `/work`, `/reel` and every other route
# was
#
#     Link: ; rel="canonical"
#
# -- a canonical hint with no URL in it. Verified live 2026-10-30 with
# `curl -sI https://horror.zazieproductions.com/`:
#   link: ; rel="canonical"
# The surrounding quotes survive, the URI is gone, so the header was never a
# usable signal and was noise on every crawl. It is removed rather than
# "fixed": RFC 8288 requires the URI in angle brackets, so any syntactically
# valid Link value would be truncated the same way.
#
# Nothing is lost. Every route already serves a self-referencing
# <link rel="canonical"> in the HTML, which is the signal Google actually uses
# for an HTML page, and `tools/check-headers.mjs` now fails the build if an
# angle-bracketed header value is added back here.
#
# Keep the X-Robots-Tag rules: those are real, they arrive intact, and they are
# the edge-level assertion that a route is indexable.
/
  X-Robots-Tag: index, follow, max-image-preview:large

/index.html
  X-Robots-Tag: index, follow, max-image-preview:large

/work
  X-Robots-Tag: index, follow, max-image-preview:large
/work/
  X-Robots-Tag: index, follow, max-image-preview:large
/work/index.html
  X-Robots-Tag: index, follow, max-image-preview:large
/work/*
