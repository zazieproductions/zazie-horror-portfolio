/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), autoplay=(self), payment=()
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# HTML — never cache; always revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Hashed / immutable static assets
/*.js
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/*.css
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# Images — long-lived immutable; filenames are content-stable, sizes are fixed
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept
  Timing-Allow-Origin: *

# Audio — immutable + allow range requests (critical for HTMLAudioElement seeking)
/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
  Access-Control-Allow-Origin: *

# SEO / config files
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Security HSTS for any upgrade
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
